{
  "extends": "@react-native/typescript-config",
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods",
    "src/headless",
    "dist-harness"
  ],
  "compilerOptions": {
    "types": [
      "node",
      "jest"
    ],
    "erasableSyntaxOnly": true
  }
}
